---
const {
  group,
  title = "Folder",
  startTop = 20,
  startLeft = 10
} = Astro.props;
---

<div
  class="folder-wrapper"
  style={`top: ${startTop}vh; left: ${startLeft}vw;`}
  data-group={group}
>
  <div class="folder">
    <img src="/images/ui/folder.png" alt="Folder" />
    <p class="folder-title">{title}</p>
  </div>
</div>

<style is:global>
.folder-wrapper {
  position: absolute;
  cursor: grab;
  user-select: none;
  z-index: 1000;
  text-align: center;
  max-width: 120px;
}

.folder-wrapper:active {
  cursor: grabbing;
}

.folder {
  display: inline-block;
  filter: drop-shadow(2px 2px 4px #7e7e7e);
}

.folder img {
  width: 80px;
  height: 80px;
  object-fit: contain;
  pointer-events: none;
}

.folder-title {
  margin: 4px 0 0;
  font-size: 0.9rem;
  color: #333;
  user-select: none;
}
</style>

<script>
document.querySelectorAll(".folder-wrapper").forEach((folder) => {
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let offsetX = 0;
  let offsetY = 0;

  folder.addEventListener("mousedown", (event) => {
    isDragging = false;
    startX = event.clientX;
    startY = event.clientY;

    const rect = folder.getBoundingClientRect();
    offsetX = event.clientX - rect.left;
    offsetY = event.clientY - rect.top;

    const mouseMove = (event) => {
      const distance = Math.sqrt(
        Math.pow(event.clientX - startX, 2) +
        Math.pow(event.clientY - startY, 2)
      );

      if (distance > 5) {
        isDragging = true;
        folder.dataset.dragging = "true";
      }

      if (!isDragging) return;

      let x = event.clientX - offsetX;
      let y = event.clientY - offsetY;

      const maxX = window.innerWidth - folder.offsetWidth;
      const maxY = window.innerHeight - folder.offsetHeight;

      x = Math.max(0, Math.min(x, maxX));
      y = Math.max(0, Math.min(y, maxY));

      folder.style.left = `${x}px`;
      folder.style.top = `${y}px`;
    };

    const mouseUp = () => {
      if (!isDragging) {
        folder.dataset.dragging = "false";
      }

      document.removeEventListener("mousemove", mouseMove);
      document.removeEventListener("mouseup", mouseUp);
    };

    document.addEventListener("mousemove", mouseMove);
    document.addEventListener("mouseup", mouseUp);
  });
});
</script>