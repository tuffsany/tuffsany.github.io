    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482940/robotics30-4_z9ry8q.jpg", alt: "Team 30645, NTHS Scrimmage" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482939/robotics30-5_igjgid.jpg", alt: "Team 30645, NTHS Scrimmage" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482938/robotics30-2_ydwvgu.jpg", alt: "Team 30645, NTHS Scrimmage" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482938/robotics30-1_cgjlme.jpg", alt: "Team 30645, NTHS Scrimmage" }
  ],

  robotics: [
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482931/robotics-5_effby9.jpg", alt: "Team 22029, Provincial Championships" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482930/robotics-4_pw8c6z.jpg", alt: "NTHS Fish Bowl" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482930/robotics-3_tgtjbk.jpg", alt: "NTHS Fish Bowl" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482930/robotics-2_uqkvac.jpg", alt: "NTHS Fish Bowl" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482930/robotics-1_zlrwsh.jpg", alt: "Team 22029, Provincial Championships" },
    { src: "https://res.cloudinary.com/dp61tlrci/image/upload/v1776482931/robotics-6_lpo5l9.jpg", alt: "NTHS Scrimmage" },
